rules_version = '2';

// Canonical cloud model: users/{uid}/state/{stateKey}.
// Atlas remains single-account/private for now. Local attempt histories and
// resettable perfect-run streaks are intentionally device-local; only durable
// learning ledgers and monotonic earned achievements are accepted here.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null && request.auth.uid == '7jSCG8qg6PN5IhibC7zAKblll8m2';
    }

    function isOwner(userId) {
      return isAllowedUser() && request.auth.uid == userId;
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time;
    }

    function isProgressKey(stateKey) {
      return stateKey in [
        'flag-atlas:progress:v1',
        'flag-atlas:location-progress:v1',
        'flag-atlas:outline-progress:v1',
        'flag-atlas:neighbor-progress:v1'
      ];
    }

    function isAchievementKey(stateKey) {
      return stateKey == 'flag-atlas:earned-achievements:v1';
    }

    function isKnownStateKey(stateKey) {
      return isProgressKey(stateKey) || isAchievementKey(stateKey);
    }

    function isValidProgressPayload(data) {
      return data is map &&
        data.keys().hasOnly(['version', 'records']) &&
        data.keys().hasAll(['version', 'records']) &&
        data.version == 2 &&
        data.records is map &&
        data.records.keys().size() <= 300;
    }

    function isValidAchievementPayload(data) {
      return data is map &&
        data.keys().hasOnly([
          'version',
          'regionDomainMasteries',
          'completeRegions',
          'completeContinents',
          'worldCrown'
        ]) &&
        data.keys().hasAll([
          'version',
          'regionDomainMasteries',
          'completeRegions',
          'completeContinents',
          'worldCrown'
        ]) &&
        data.version == 1 &&
        data.regionDomainMasteries is list && data.regionDomainMasteries.size() <= 500 &&
        data.completeRegions is list && data.completeRegions.size() <= 200 &&
        data.completeContinents is list && data.completeContinents.size() <= 6 &&
        data.worldCrown is bool;
    }

    function isValidStatePayload(stateKey, data) {
      return (isProgressKey(stateKey) && isValidProgressPayload(data)) ||
        (isAchievementKey(stateKey) && isValidAchievementPayload(data));
    }

    function isValidStateDoc(stateKey) {
      let resourceData = request.resource.data;
      return isKnownStateKey(stateKey) &&
        resourceData.keys().hasOnly(['data', 'schemaVersion', 'updatedAt']) &&
        resourceData.keys().hasAll(['data', 'schemaVersion', 'updatedAt']) &&
        resourceData.schemaVersion == 1 &&
        isRecent(resourceData.updatedAt) &&
        isValidStatePayload(stateKey, resourceData.data);
    }

    match /users/{userId}/state/{stateKey} {
      allow read, delete: if isOwner(userId) && isKnownStateKey(stateKey);
      allow create, update: if isOwner(userId) && isValidStateDoc(stateKey);
    }
  }
}
